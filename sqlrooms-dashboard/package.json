{
  "name": "sqlrooms-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepare:data": "python3 ../scripts/prepare_dashboard.py",
    "build:publication": "npm run prepare:data && npm run build",
    "test:data": "cd .. && python3 scripts/test_data.py",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:headless": "python3 ../scripts/validate_headless.py",
    "lint": "oxlint src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
